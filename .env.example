# Copy this to Vercel's Project → Settings → Environment Variables.
# Never commit a real .env file, and never paste secret values into a chat
# with an AI assistant — the ones marked SECRET below should be typed
# directly into Vercel's dashboard.

# ── Supabase ──────────────────────────────────────────────────────────
# Project → Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=                     # SECRET — "service_role" key, not "anon"

# ── Session signing ───────────────────────────────────────────────────
# Any long random string, e.g. output of: openssl rand -hex 32
APP_SESSION_SECRET=                            # SECRET

# ── MSG91 (OTP) ───────────────────────────────────────────────────────
MSG91_AUTH_KEY=                                # SECRET
MSG91_TEMPLATE_ID=                             # your OTP template id from the MSG91 dashboard

# ── Razorpay ──────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx          # safe to expose to the client, not a secret
RAZORPAY_KEY_SECRET=                           # SECRET

# ── Admin access ──────────────────────────────────────────────────────
# Comma-separated phone numbers (any format) allowed to log into /admin.
ADMIN_PHONES=9876543210,9123456780

# ── Cron security ─────────────────────────────────────────────────────
# Any random string. Vercel automatically sends it back as
# `Authorization: Bearer $CRON_SECRET` when it triggers your cron job.
CRON_SECRET=                                   # SECRET

# ── Optional: partner payout, hero videos ────────────────────────────
PARTNER_PAYOUT_PER_DELIVERY=15
MILK_VIDEO_URL=https://YOUR-PROJECT-REF.supabase.co/storage/v1/object/public/media/milk_animation.mp4
VEGETABLE_VIDEO_URL=https://YOUR-PROJECT-REF.supabase.co/storage/v1/object/public/media/vegitable_animation_.mp4
